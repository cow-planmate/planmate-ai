# planmate-ai 로컬 환경변수 템플릿. 실제 값은 .env 에 (gitignore)

# AI 캐시 DB (docker-compose.local.yml 의 tourdata-postgres, host 포트 5434)
AI_DB_DSN=postgresql://tourdata:tourdata@localhost:5434/tourdata

# FastAPI 리슨 포트
PORT=8010

# v2 가 X-Internal-Token 헤더로 보낼 공유 시크릿 (Phase A 는 로드만, 검증은 Phase F)
INTERNAL_SHARED_SECRET=dev-secret

# Vertex AI (google-genai). 인증 = ADC — 로컬은 먼저:
#   gcloud auth application-default login
#   gcloud auth application-default set-quota-project planmate-507517
# VM(프로덕션)은 서비스계정 attach (Phase G, 18 §4-2). API 키(GEMINI_API_KEY) 방식 폐기.
GOOGLE_CLOUD_PROJECT=planmate-507517
GOOGLE_CLOUD_LOCATION=global
